#!/usr/bin/env bash
# Builds the site like production and checks the result. Used by CI (.github/workflows/ci.yml)
# and locally: `make check` (in Docker) or `script/check` (with Ruby and Node installed).
set -euo pipefail

cd "$(dirname "$0")/.."

SITE_DIR="${SITE_DIR:-_site}"
export JEKYLL_ENV=production

step() { printf '\n==> %s\n' "$1"; }

step "Build the site (fails on errors and on any warning)"
build_log="$(mktemp)"
trap 'rm -f "$build_log"' EXIT
bundle exec jekyll build --strict_front_matter --destination "$SITE_DIR" 2>&1 | tee "$build_log"
if grep -Eiq 'warn|deprecat|error' "$build_log"; then
  echo "The build printed warnings or errors (see above)." >&2
  exit 1
fi

step "Check links, images and scripts of the built site"
# External links are checked separately on a schedule (they fail for reasons outside this repo).
# docs/ is an old copy of the previous site that is not generated by this theme.
bundle exec htmlproofer "$SITE_DIR" \
  --disable-external \
  --ignore-files "/\/docs\//" \
  --checks "Links,Images,Scripts,Favicon"

step "Check that no page loads third-party resources without consent"
ruby script/check-third-party.rb "$SITE_DIR"

step "Check the syntax of the theme's JavaScript"
if command -v node >/dev/null 2>&1; then
  for file in _theme/jekyll-theme-fk/assets/theme/js/consent.js \
              _theme/jekyll-theme-fk/assets/theme/js/mermaid-setup.js; do
    node --check "$file"
    echo "ok: $file"
  done
elif [ -n "${CI:-}" ]; then
  echo "Node.js is required in CI for the JavaScript syntax check." >&2
  exit 1
else
  echo "SKIPPED: Node.js is not installed (the Docker image has none); CI runs this check."
fi

step "All checks passed"
